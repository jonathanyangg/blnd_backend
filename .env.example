SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key
SUPABASE_SERVICE_KEY=your-secret-key
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
TMDB_API_KEY=your-tmdb-api-key
OPENAI_API_KEY=your-openai-api-key

# Collaborative filtering kill switch. Restart the API after changing these.
# CF_ENABLED=false ranks with embedding similarity only (match scores too).
# CF_BLEND_WEIGHT is the fraction of the similarity term taken from CF when
# both signals exist: 1 (default) keeps the CF score, 0 uses the embedding.
CF_ENABLED=true
CF_BLEND_WEIGHT=1.0
