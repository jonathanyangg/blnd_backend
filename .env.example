SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key
SUPABASE_SERVICE_KEY=your-secret-key
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
TMDB_API_KEY=your-tmdb-api-key
OPENAI_API_KEY=your-openai-api-key

# Collaborative filtering kill switch. Restart the API after changing these.
# CF_ENABLED=false ranks with embedding similarity only (match scores too).
# CF_BLEND_WEIGHT is the fraction of the similarity term taken from CF when
# both signals exist: 1 (default) keeps the CF score, 0 uses the embedding.
CF_ENABLED=true
CF_BLEND_WEIGHT=1.0

# Origin used in click_url. Set this on Render so links are not the internal host.
# PUBLIC_BASE_URL=https://blnd-backend.onrender.com

# Amazon Associates. Unset uses blndmovies-20 on the redirect only.
# Set empty to omit tag=. Clients must not append tag=.
# AMAZON_ASSOCIATES_TAG=blndmovies-20
AMAZON_ASSOCIATES_ENABLED=true
# Stubs. Leave disabled until the network issues a tracking template.
IMPACT_ENABLED=false
IMPACT_PARTNER_ID=
RAKUTEN_ENABLED=false
RAKUTEN_PARTNER_ID=
CJ_ENABLED=false
CJ_PARTNER_ID=
APPLE_TV_AFFILIATE_ENABLED=false
APPLE_TV_AFFILIATE_TOKEN=
# Leave false in production. Streaming links then omit an Amazon affiliate tag.
AMAZON_AFFILIATE_ENABLED=false
AMAZON_AFFILIATE_TAG=
