SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key
SUPABASE_SERVICE_KEY=your-secret-key
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
TMDB_API_KEY=your-tmdb-api-key
OPENAI_API_KEY=your-openai-api-key

# Amazon Associates. Leave unset to use the public tag blndmovies-20.
# Set AMAZON_ASSOCIATES_TAG to empty to send untagged links.
# AMAZON_ASSOCIATES_TAG=blndmovies-20
AMAZON_ASSOCIATES_ENABLED=true
# Stubs. Leave disabled until the network issues a tracking template.
IMPACT_ENABLED=false
IMPACT_PARTNER_ID=
RAKUTEN_ENABLED=false
RAKUTEN_PARTNER_ID=
CJ_ENABLED=false
CJ_PARTNER_ID=
APPLE_TV_AFFILIATE_ENABLED=false
APPLE_TV_AFFILIATE_TOKEN=
